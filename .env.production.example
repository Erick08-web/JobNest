# Dominio publico sin protocolo, por ejemplo jobnest.example.com
PUBLIC_DOMAIN=jobnest.example.com

# Flask
FLASK_SECRET_KEY=replace-with-a-long-random-production-value
DATA_ENCRYPTION_KEY=replace-with-a-fernet-key-generated-with-python
JWT_SECRET_KEY=replace-with-a-different-long-random-production-value
JWT_ACCESS_MINUTES=20
JWT_REFRESH_DAYS=14
TRUST_PROXY_HEADERS=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=Lax
CORS_ALLOWED_ORIGINS=https://jobnest.example.com
LOG_LEVEL=INFO
LOG_FORMAT=json
APP_VERSION=1.0.0
INSTANCE_ID=api1
PROMETHEUS_RETENTION=15d
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-grafana-password

# Frontend V2 / móvil V2
NEXT_PUBLIC_API_URL=https://jobnest.example.com
NEXT_PUBLIC_BACKEND_URL=https://jobnest.example.com
EXPO_PUBLIC_API_URL=https://jobnest.example.com

# SQL Server
MSSQL_SA_PASSWORD=replace-with-a-strong-production-sa-password
DB_DRIVER={ODBC Driver 18 for SQL Server}
DB_SERVER=sqlserver,1433
DB_NAME=JobNest
DB_USER=SA
DB_PASSWORD=replace-with-your-database-password
DB_ENCRYPT=yes
DB_TRUST_SERVER_CERTIFICATE=no
DB_TIMEOUT=30

# Correo
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=465
MAIL_USE_TLS=false
MAIL_USE_SSL=true
EMAIL_USER=your-email@example.com
EMAIL_PASSWORD=replace-with-an-app-password

# Recuperación de contraseña
PASSWORD_RESET_TOKEN_MINUTES=30
PASSWORD_RESET_MAX_PER_EMAIL=3
PASSWORD_RESET_MAX_PER_IP=10
PASSWORD_RESET_WINDOW_MINUTES=15
MAIL_MODE=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=10
MAIL_FROM=
WEB_BASE_URL=https://jobnest.example.com
MOBILE_DEEP_LINK_BASE=jobnest://restablecer-password

# Administradores web V2 separados por coma
ADMIN_EMAILS=admin@example.com

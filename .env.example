# Flask
FLASK_SECRET_KEY=replace-with-a-long-random-value
DATA_ENCRYPTION_KEY=replace-with-a-fernet-key-generated-with-python
JWT_SECRET_KEY=replace-with-a-different-long-random-value
JWT_ACCESS_MINUTES=20
JWT_REFRESH_DAYS=14

# Servidor Flask / despliegue local
FLASK_ENV=development
TRUST_PROXY_HEADERS=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO
LOG_FORMAT=text
APP_VERSION=dev
INSTANCE_ID=api-dev
PROMETHEUS_RETENTION=15d
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-local-grafana-password

# Frontend V2 / móvil V2
NEXT_PUBLIC_API_URL=http://127.0.0.1:5001
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:5001
EXPO_PUBLIC_API_URL=http://127.0.0.1:5001

# SQL Server
MSSQL_SA_PASSWORD=replace-with-a-strong-local-sa-password
DB_DRIVER={ODBC Driver 18 for SQL Server}
DB_SERVER=localhost,1433
DB_NAME=JobNest
DB_USER=SA
DB_PASSWORD=replace-with-your-database-password
DB_ENCRYPT=yes
DB_TRUST_SERVER_CERTIFICATE=yes
DB_TIMEOUT=30

# Correo
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=465
MAIL_USE_TLS=false
MAIL_USE_SSL=true
EMAIL_USER=your-email@example.com
EMAIL_PASSWORD=replace-with-an-app-password

# Administradores web V2 separados por coma
ADMIN_EMAILS=admin@example.com
